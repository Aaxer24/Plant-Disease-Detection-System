# Plant Disease Detection API — Environment Variables
# Copy this file to .env and fill in your values

# ── Groq AI (free tier: https://console.groq.com) ──────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Model ──────────────────────────────────────────────
MODEL_DIR=models
MODEL_NAME=plant_disease_model
IMAGE_SIZE=256

# ── MLflow ─────────────────────────────────────────────
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=plant-disease-detection

# ── API ────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]
